<?xml version="1.0" encoding="utf-8"?>
<!-- A Material 3 switch in the "off" position, scaled down to 39dp x 24dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <stroke
                android:width="1.5dp"
                android:color="@color/widget_text_secondary" />
            <corners android:radius="12dp" />
            <size
                android:width="39dp"
                android:height="24dp" />
        </shape>
    </item>
    <item
        android:bottom="6dp"
        android:left="6dp"
        android:right="21dp"
        android:top="6dp">
        <shape android:shape="oval">
            <solid android:color="@color/widget_text_secondary" />
        </shape>
    </item>
</layer-list>
