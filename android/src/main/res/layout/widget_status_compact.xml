<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <!-- Connection: switch, tailnet and state, and the Tailscale logo in place of the avatar. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The padding enlarges the switch's touch target. -->
        <FrameLayout
            android:id="@+id/widget_status_switch_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="4dp"
            android:paddingStart="0dp"
            android:paddingEnd="8dp">

            <ImageView
                android:id="@+id/widget_status_switch"
                android:layout_width="39dp"
                android:layout_height="24dp"
                android:contentDescription="@null"
                android:src="@drawable/widget_switch_off" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status_tailnet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/tile_name"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/not_connected"
                android:textColor="@color/widget_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- RemoteViews only supports the framework tint attribute, not AppCompat's app:tint. -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="6dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_logo"
            android:tint="@color/widget_text_primary"
            tools:ignore="UseAppTint" />
    </LinearLayout>

    <!-- Exit node: tapping the box opens the list, the button switches the exit node on and off. -->
    <LinearLayout
        android:id="@+id/widget_status_exit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_container"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        android:paddingStart="10dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_status_exit_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_status_exit_title"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                tools:ignore="SmallSp" />

            <TextView
                android:id="@+id/widget_status_exit_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/ic_widget_drop_down"
                android:drawableTint="@color/widget_text_secondary"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/none"
                android:textColor="@color/widget_text_primary"
                android:textSize="12sp"
                tools:ignore="UseCompatTextViewDrawableXml" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_status_exit_button"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button"
            android:gravity="center"
            android:maxLines="1"
            android:paddingHorizontal="12dp"
            android:text="@string/enable"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
